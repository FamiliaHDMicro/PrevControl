{
  "name": "prevcontrol",
  "main": "index.js",
  "compatibility_date": "2026-08-28",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "prevcontrol-db",
      "database_id": "a759cb1e-8e43-405d-a5d2-5aab5819adcd"
    }
  ],
  "ai": {
    "binding": "AI"
  }
}
